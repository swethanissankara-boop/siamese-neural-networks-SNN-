import base64
from io import BytesIO
from PIL import Image

def array_to_base64(img_array):
    if img_array.ndim == 2:  # grayscale
        pil_img = Image.fromarray((img_array * 255).astype('uint8'), mode='L')
    elif img_array.ndim == 3 and img_array.shape[2] == 1:
        pil_img = Image.fromarray((img_array.squeeze() * 255).astype('uint8'), mode='L')
    else:
        pil_img = Image.fromarray((img_array * 255).astype('uint8'), mode='RGB')

    pil_img = pil_img.resize((64, 64), resample=Image.LANCZOS)

    buf = BytesIO()
    pil_img.save(buf, format='PNG')
    base64_bytes = base64.b64encode(buf.getvalue())
    base64_string = base64_bytes.decode('utf-8')
    return f"data:image/png;base64,{base64_string}"

# Convert all test images to base64 strings
images_base64 = [array_to_base64(img) for img in x_test]

# Save to .npy file
np.save('images_base64.npy', np.array(images_base64))
